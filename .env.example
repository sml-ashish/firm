# ---------------------------------------------------------------------------
# FIRM - Fleet Classification Tool
# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Leave DATABASE_URL empty to use the embedded PGlite database stored in
# ./.data/pglite (zero-install, best for local use / demos).
#
# For a production deployment, point this at PostgreSQL:
# DATABASE_URL=postgres://firm:firm@localhost:5432/firm
DATABASE_URL=

# Optional: directory for the embedded database (default ./.data/pglite)
# PGLITE_DIR=./.data/pglite

# ---------------------------------------------------------------------------
# Sessions
# ---------------------------------------------------------------------------
# Change this in any shared/production environment.
SESSION_SECRET=change-me-to-a-long-random-string

# ---------------------------------------------------------------------------
# Demo data
# ---------------------------------------------------------------------------
# Demo users and policy defaults are seeded automatically on first connection.
# To load the sample fleet, run: npm run seed:demo
